{
  "name": "@oktis-works/telos-sdd-graph",
  "version": "3.4.1",
  "description": "OpenCode Telos - Spec-Driven Development plugin with Knowledge Graph enforcement",
  "homepage": "https://github.com/JudahAragao/opencode-telos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JudahAragao/opencode-telos.git"
  },
  "bugs": {
    "url": "https://github.com/JudahAragao/opencode-telos/issues"
  },
  "license": "MIT",
  "author": "Telos Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/sync-version.cjs && tsc && node scripts/copy-ui-assets.cjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "version:sync": "node scripts/sync-version.cjs",
    "prepack": "npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "typescript": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "bun-types": "^1.4.4",
    "oxlint": "^1.95.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sdd",
    "spec-driven-development",
    "knowledge-graph",
    "drift-detection",
    "enforcement",
    "telos"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
